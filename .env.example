# cloud = Voyage AI + Claude, local = Ollama on pc (nomic-embed-text + qwen3:8b)
RAG_PROVIDER=cloud

ANTHROPIC_API_KEY=your_anthropic_api_key
VOYAGE_API_KEY=your_voyage_api_key
VAULT_PATH=/path/to/your/obsidian/vault
# Used for obsidian://open links in the web app
VAULT_NAME=baz-vault

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=obsidian_rag
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Local provider (defaults shown)
# OLLAMA_URL=https://pc.taila3582d.ts.net:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_TIMEOUT=180

# Optional tuning
# CLAUDE_MODEL=claude-sonnet-4-6
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=      # default 0.35 for cloud, 0.5 for local
# RAG_STORE=postgres       # or memory: index the vault inside the server process, no Postgres
